  IsCharacterSpeak: 0
  CharacterText: 
  NPCText: "\u041D\u0435 \u0441\u043F\u0435\u0448\u0438, \u0441\u043F\u0435\u0440\u0432\u0430
    \u0441\u0442\u043E\u0438\u0442 \u043F\u043E\u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F.
    \u0412\u044B\u0431\u0435\u0440\u0438 \u0443\u0440\u043E\u0432\u0435\u043D\u044C.
    \u0414\u043B\u044F \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F
    \u043A\u043B\u0438\u043A\u043D\u0438 \u041B\u041A\u041C \u0432 \u043B\u044E\u0431\u043E\u0435
    \u043C\u0435\u0441\u0442\u043E, \u043A\u0443\u0434\u0430 \u0445\u043E\u0447\u0435\u0448\u044C
    \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F.
    \u0427\u0442\u043E\u0431\u044B \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u043D\u0430
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C, \u0432\u0441\u0442\u0430\u043D\u044C
    \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0443\u044E \u043F\u043B\u0438\u0442\u043A\u0443"
