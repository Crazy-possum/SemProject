  IsCharacterSpeak: 1
  CharacterText: "\u0422\u043E\u0447\u043D\u043E, \u0437\u0430\u0431\u044B\u043B\u0430
    \u0443\u043F\u043E\u043C\u044F\u043D\u0443\u0442\u044C. \u0427\u0442\u043E\u0431\u044B
    \u0431\u0430\u0448\u043D\u044F \u043C\u043E\u0433\u043B\u0430 \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0442\u044C,
    \u043A\u043E\u0433\u043E \u043E\u0442\u0441\u0442\u0440\u0435\u043B\u0438\u0432\u0430\u0442\u044C,
    \u043D\u0443\u0436\u043D\u043E \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u044B\u043F\u0430\u0447\u043A\u0430\u0442\u044C
    \u0432\u0440\u0430\u0433\u0430 \u0432 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u043A\u0440\u0430\u0441\u043A\u0435. \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E
    \u044F \u0441\u0434\u0435\u043B\u0430\u043B\u0430 \u0441\u0435\u0431\u0435 \u043E\u0441\u043E\u0431\u044B\u0439
    \u0440\u044E\u043A\u0437\u0430\u043A-\u043F\u0443\u0448\u043A\u0443"
